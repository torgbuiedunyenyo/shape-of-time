{
  "name": "shape-of-time", "private": true, "type": "module", "version": "0.1.0",
  "engines": {"node": "24.18.0"}, "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx watch --env-file=.env src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run", "lint": "eslint .",
    "gates": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "inspect": "tsx --env-file=.env scripts/inspect.ts",
    "eval:live": "tsx --env-file=.env scripts/live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0", "@hono/node-server": "2.0.10", "hono": "4.12.31",
    "kysely": "0.29.4", "pg": "8.22.0", "openai": "7.10.0", "marked": "18.0.11",
    "react": "19.2.7", "react-dom": "19.2.7", "react-router": "8.2.0", "sharp": "0.35.4", "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1", "eslint": "10.7.0", "typescript-eslint": "8.64.0", "globals": "17.7.0",
    "@types/node": "24.13.3", "@types/pg": "8.20.0", "@types/react": "19.2.17", "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3", "typescript": "6.0.3", "tsx": "4.23.1", "vite": "8.1.5", "vitest": "4.1.10"
  }
}
